{
  "name": "mythic-jung-backend",
  "version": "1.1.0",
  "description": "Backend API for Mythic Jung Flutter App - Production Ready",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate && prisma db push --accept-data-loss || echo 'Prisma setup skipped'"
  },
  "keywords": [
    "jung",
    "archetypes",
    "api",
    "psychology"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "7.4.0",
    "ioredis": "^5.4.1",
    "openai": "^4.20.1",
    "p-queue": "8.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "prisma": "5.22.0"
  }
}
