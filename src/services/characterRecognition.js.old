    'm': { framework: 'Mystery decisions', values: ['Depth', 'Mystery', 'Hidden'], compass: 'Depth ethics' },
    'n': { framework: 'Natural decisions', values: ['Nature', 'Authenticity', 'Organic'], compass: 'Natural ethics' },
    'o': { framework: 'Origin decisions', values: ['Source', 'Origin', 'Foundation'], compass: 'Origin ethics' },
    'p': { framework: 'Power decisions', values: ['Power', 'Influence', 'Capacity'], compass: 'Power ethics' },
    'q': { framework: 'Quest decisions', values: ['Search', 'Inquiry', 'Quest'], compass: 'Quest ethics' },
    'r': { framework: 'Resilient decisions', values: ['Resilience', 'Endurance', 'Recovery'], compass: 'Resilience ethics' },
    's': { framework: 'Spirit decisions', values: ['Spirit', 'Soul', 'Essence'], compass: 'Spiritual ethics' },
    't': { framework: 'Transforming decisions', values: ['Change', 'Transformation', 'Evolution'], compass: 'Transformation ethics' },
    'u': { framework: 'Unifying decisions', values: ['Unity', 'Integration', 'Wholeness'], compass: 'Unity ethics' },
    'v': { framework: 'Vision decisions', values: ['Vision', 'Clarity', 'Perspective'], compass: 'Vision ethics' },
    'w': { framework: 'Wise decisions', values: ['Wisdom', 'Understanding', 'Insight'], compass: 'Wisdom ethics' },
    'x': { framework: 'Unknown decisions', values: ['Mystery', 'Unknown', 'Hidden'], compass: 'Mystery ethics' },
    'y': { framework: 'Yearning decisions', values: ['Desire', 'Aspiration', 'Yearning'], compass: 'Aspiration ethics' },
    'z': { framework: 'Zenith decisions', values: ['Completion', 'Peak', 'Zenith'], compass: 'Completion ethics' },
  };
  
  const decisionInfo = decisionByChar[firstChar];
  if (decisionInfo) {
    recognition.decisionFramework = decisionInfo.framework;
    recognition.valueHierarchy = decisionInfo.values;
    recognition.moralCompass = decisionInfo.compass;
  } else {
    recognition.decisionFramework = `Unique decision framework of "${firstChar}"`;
    recognition.valueHierarchy = [`Value of "${firstChar}"`];
    recognition.moralCompass = `Unique ethics of "${firstChar}"`;
  }
}

/**
 * Recognize energy signature
 * Based on the actual character name
 */
function recognizeEnergySignature(name, recognition, allCharacters) {
  // Energy signature based on the actual character
  if (!recognition.energySignature) {
    const firstChar = name[0].toLowerCase();
    
    // Energy signatures by character
    const energyByChar = {
      'a': { signature: 'Alpha energy, initiating force', presence: 'Primary presence, foundational impact' },
      'b': { signature: 'Building energy, connecting force', presence: 'Connecting presence, bridging impact' },
      'c': { signature: 'Centering energy, focusing force', presence: 'Focused presence, core impact' },
      'd': { signature: 'Deep energy, foundational force', presence: 'Stable presence, foundational impact' },
      'e': { signature: 'Essential energy, core force', presence: 'Core presence, essential impact' },
      'f': { signature: 'Flowing energy, dynamic force', presence: 'Dynamic presence, flowing impact' },
      'g': { signature: 'Growing energy, expanding force', presence: 'Expanding presence, growth impact' },
      'h': { signature: 'Height energy, elevating force', presence: 'Elevated presence, transcendent impact' },
      'i': { signature: 'Identity energy, self force', presence: 'Individual presence, self impact' },
      'j': { signature: 'Journey energy, exploring force', presence: 'Exploratory presence, journey impact' },
      'k': { signature: 'Keeping energy, protective force', presence: 'Protective presence, preserving impact' },
      'l': { signature: 'Light energy, illuminating force', presence: 'Illuminating presence, clarifying impact' },
      'm': { signature: 'Mystery energy, hidden force', presence: 'Mysterious presence, deep impact' },
      'n': { signature: 'Natural energy, authentic force', presence: 'Authentic presence, natural impact' },
      'o': { signature: 'Origin energy, source force', presence: 'Source presence, original impact' },
      'p': { signature: 'Power energy, influential force', presence: 'Powerful presence, influential impact' },
      'q': { signature: 'Quest energy, seeking force', presence: 'Seeking presence, inquiring impact' },
      'r': { signature: 'Resilient energy, enduring force', presence: 'Enduring presence, resilient impact' },
      's': { signature: 'Spirit energy, soul force', presence: 'Spiritual presence, soul impact' },
      't': { signature: 'Transforming energy, changing force', presence: 'Transforming presence, change impact' },
      'u': { signature: 'Unifying energy, integrating force', presence: 'Unifying presence, whole impact' },
      'v': { signature: 'Vision energy, clear force', presence: 'Visionary presence, clear impact' },
      'w': { signature: 'Wise energy, understanding force', presence: 'Wise presence, understanding impact' },
      'x': { signature: 'Unknown energy, mysterious force', presence: 'Mysterious presence, unknown impact' },
      'y': { signature: 'Yearning energy, aspiring force', presence: 'Aspiring presence, desiring impact' },
      'z': { signature: 'Zenith energy, complete force', presence: 'Complete presence, peak impact' },
    };
    
    const energyInfo = energyByChar[firstChar];
    if (energyInfo) {
      recognition.energySignature = energyInfo.signature;
      recognition.presenceQuality = energyInfo.presence;
    } else {
      recognition.energySignature = `Unique energy of "${firstChar}"`;
      recognition.presenceQuality = `Unique presence of "${firstChar}"`;
    }
  }
}

/**
 * Recognize shadow and light elements
 */
function recognizeShadowAndLight(name, recognition, allCharacters) {
  // Shadow and light are discovered through position and context
  const charIndex = allCharacters.findIndex(c => 
    (c.displayName || c.id).toLowerCase() === name
  );
  
  // Characters in later positions often carry more shadow
  if (charIndex >= 3) {
    recognition.shadowElements.push('Repressed aspects', 'Hidden qualities', 'Denied potential');
    recognition.lightElements.push('Hidden gifts', 'Unrecognized strengths', 'Emerging virtues');
  } else {
    recognition.shadowElements.push('Blind spots', 'Unseen limitations', 'Hidden costs');
    recognition.lightElements.push('Visible strengths', 'Recognized gifts', 'Acknowledged virtues');
  }
  
  recognition.integrationPotential = 'Integration of shadow and light creates wholeness';
}

/**
 * Recognize narrative function
 */
function recognizeNarrativeFunction(name, recognition, allCharacters, position) {
  // Narrative function based on position
  if (position === 'ego') {
    recognition.narrativeRole = 'Protagonist';
    recognition.storyFunction = 'Carries the conscious story forward';
    recognition.transformationPotential = 'From narrow identity to expanded self';
  } else if (position === 'persona') {
    recognition.narrativeRole = 'Mask';
    recognition.storyFunction = 'Adapts story for social acceptance';
    recognition.transformationPotential = 'From mask to transparency';
  } else if (position === 'shadow') {
    recognition.narrativeRole = 'Shadow guide';
    recognition.storyFunction = 'Challenges and transforms the story';
    recognition.transformationPotential = 'From repression to integration';
  } else {
    recognition.narrativeRole = 'Supporting archetype';
    recognition.storyFunction = 'Enriches and deepens the story';
    recognition.transformationPotential = 'From background to foreground';
  }
}

/**
 * Discover surprising insights - what's unexpected
 */
function discoverSurprisingInsights(name, recognition, allCharacters) {
  // The recognition engine should find what's surprising
  
  // Surprise: Simple names can have complex functions
  if (name.length <= 2) {
    recognition.surprisingAspects.push(
      'Simplicity belies depth',
      'Direct name, potentially complex function',
      'Essential nature may contain hidden layers'
    );
  }
  
  // Surprise: Position reveals unexpected patterns
  const charIndex = allCharacters.findIndex(c => 
    (c.displayName || c.id).toLowerCase() === name
  );
  
  if (charIndex === 0 && recognition.primaryArchetype !== 'Hero') {
    recognition.contradictions.push('First position but not hero archetype - interesting tension');
  }
  
  // Surprise: Hidden capacities
  recognition.hiddenDepths.push(
    'Depth to be discovered through narrative',
    'Hidden aspects will emerge through story',
    'Surprising connections to other characters'
  );
  
  // The most surprising insight: what this character reveals about the user
  recognition.surprisingAspects.push(
    `This character reveals something unexpected about you`,
    `The choice of "${name}" as ${recognition.primaryArchetype} is significant`,
    `There is meaning in this selection that will emerge through analysis`
  );
}

/**
 * Recognize all characters deeply
 */
export function recognizeAllCharacters(characters, assessments = []) {
  return characters.map(char => {
    const name = char.displayName || char.id;
    // Determine position from assessments if available
    let position = null;
    
    // Try to infer position from assessments
    assessments.forEach(assessment => {
      if (assessment.selectedCharacterIds && 
          assessment.selectedCharacterIds.includes(char.id)) {
        switch (assessment.assessmentType) {
          case 'EGO_POSITION':
            position = 'ego';
            break;
          case 'PERSONA_FORMATION':
            position = 'persona';
            break;
          case 'SHADOW_PROXIMITY':
            position = 'shadow';
            break;
        }
      }
    });
    
    return recognizeCharacter(name, characters, position);
  });
}
